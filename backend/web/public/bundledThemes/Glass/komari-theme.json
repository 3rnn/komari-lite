{
  "name": "Komari Glass",
  "short": "Glass",
  "description": "A lightweight public monitoring theme for Komari Lite",
  "version": "1.1.0",
  "author": "mengying",
  "url": "https://github.com/imengying/Komari-Glass",
  "preview": "dist/preview.png",
  "configuration": {
    "type": "managed",
    "icon": "Bolt",
    "name": "Theme settings",
    "data": [
      {
        "name": {
          "zh-CN": "Appearance",
          "en": "Appearance"
        },
        "type": "title"
      },
      {
        "key": "defaultAppearance",
        "name": {
          "zh-CN": "Default Appearance",
          "en": "Default Appearance"
        },
        "type": "select",
        "options": "system,light,dark",
        "default": "system",
        "help": {
          "zh-CN": "system follows OS; user local choice overrides this.",
          "en": "system follows OS; user local choice overrides this."
        }
      },
      {
        "key": "assetCurrency",
        "name": {
          "zh-CN": "Asset Currency",
          "en": "Asset Currency"
        },
        "type": "select",
        "options": "CNY,USD,HKD,EUR,GBP,JPY,RUB,CHF,INR,VND,THB,CAD",
        "default": "CNY",
        "help": {
          "zh-CN": "Convert node prices to this currency",
          "en": "Convert node prices to this currency"
        }
      },
      {
        "key": "enableBlur",
        "name": {
          "zh-CN": "Enable Glass Blur",
          "en": "Enable Glass Blur"
        },
        "type": "switch",
        "default": true
      },
      {
        "key": "backgroundImage",
        "name": {
          "zh-CN": "Background Image URL",
          "en": "Background Image URL"
        },
        "type": "string",
        "default": "",
        "help": {
          "zh-CN": "Use | to separate light/dark backgrounds",
          "en": "Use | to separate light/dark backgrounds"
        }
      },
      {
        "name": {
          "zh-CN": "Server Cards",
          "en": "Server Cards"
        },
        "type": "title"
      },
      {
        "key": "showCarrierPing",
        "name": {
          "zh-CN": "Enable Carrier Ping",
          "en": "Enable Carrier Ping"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "Show carrier-specific latency and loss; when disabled, show aggregate latency and loss.",
          "en": "Show carrier-specific latency and loss; when disabled, show aggregate latency and loss."
        }
      },
      {
        "key": "telecomPingTaskName",
        "name": {
          "zh-CN": "Telecom Ping Task Name",
          "en": "Telecom Ping Task Name"
        },
        "type": "string",
        "default": "",
        "help": {
          "zh-CN": "Only used when carrier ping is enabled. Enter the exact task name, or leave all three empty to match carrier names first and fill unmatched slots in backend order.",
          "en": "Only used when carrier ping is enabled. Enter the exact task name, or leave all three empty to match carrier names first and fill unmatched slots in backend order."
        }
      },
      {
        "key": "mobilePingTaskName",
        "name": {
          "zh-CN": "Mobile Ping Task Name",
          "en": "Mobile Ping Task Name"
        },
        "type": "string",
        "default": "",
        "help": {
          "zh-CN": "Only used when carrier ping is enabled.",
          "en": "Only used when carrier ping is enabled."
        }
      },
      {
        "key": "unicomPingTaskName",
        "name": {
          "zh-CN": "Unicom Ping Task Name",
          "en": "Unicom Ping Task Name"
        },
        "type": "string",
        "default": "",
        "help": {
          "zh-CN": "Only used when carrier ping is enabled.",
          "en": "Only used when carrier ping is enabled."
        }
      },
      {
        "name": {
          "zh-CN": "Overview",
          "en": "Overview"
        },
        "type": "title"
      },
      {
        "key": "showStatsBar",
        "name": {
          "zh-CN": "Show Stats Bar",
          "en": "Show Stats Bar"
        },
        "type": "switch",
        "default": true
      },
      {
        "key": "showOnline",
        "name": {
          "zh-CN": "Show Online",
          "en": "Show Online"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "Show online node count",
          "en": "Show online node count"
        }
      },
      {
        "key": "showAssets",
        "name": {
          "zh-CN": "Show Assets",
          "en": "Show Assets"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "Show total and remaining value",
          "en": "Show total and remaining value"
        }
      },
      {
        "key": "showTraffic",
        "name": {
          "zh-CN": "Show Traffic",
          "en": "Show Traffic"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "Show total traffic",
          "en": "Show total traffic"
        }
      },
      {
        "key": "showSpeed",
        "name": {
          "zh-CN": "Show Network Speed",
          "en": "Show Network Speed"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "Show realtime speed",
          "en": "Show realtime speed"
        }
      }
    ]
  }
}
