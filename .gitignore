# Runtime state — never commit panel data or credentials
data/
**/data/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
.env
.env.local
.env.*.local
secrets/
credentials/
*credential*
*passphrase*

# Backups, releases, and generated binaries
# Root-anchored: source packages such as backend/web/backup/ must stay tracked.
/backup/
/backups/
/rollback/
/komari
/komari.new
/komari.prev.*
*.exe
*.zip
*.tar
*.tar.*
*.tgz
*.new
*.prev.*
agent-release/
release/
agent/build/

# Frontend / Go build caches
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
backend/tmp/
backend/.cache/
*.test
coverage.out

# Local editor and operating system files
.DS_Store
.idea/
.vscode/
*.swp
